
@baseUrl = http://localhost:8000/api


# @name baseline
GET {{baseUrl}}/production-orders

{{
  const body = response.parsedBody;
  const first = body.data[0];

  exports.sampleWo = first.wo_number;
  exports.sampleProductCode = first.product.code;
  exports.sampleProductName = first.product.name;
  exports.sampleMachineCode = first.machine.code;
  exports.sampleStatus = first.status;
  exports.samplePlanDate = first.plan_start.slice(0, 10);
  exports.sampleOperator = first.operator.name;
}}

### Search by WO number
# @ref baseline
GET {{baseUrl}}/production-orders
    ?search={{sampleWo}}

### Search by product name
# @ref baseline
GET {{baseUrl}}/production-orders
    ?search={{encodeURIComponent(sampleProductName)}}
    &per_page=100

### Search by operator name
# @ref baseline
GET {{baseUrl}}/production-orders
    ?search={{encodeURIComponent(sampleOperator)}}
    &per_page=100

### Search  - no match
GET {{baseUrl}}/production-orders
    ?search=zzzzzz-fake-orddder

### Filter by product (product_code)
# @ref baseline
GET {{baseUrl}}/production-orders
    ?product={{sampleProductCode}}
    &per_page=100

### Filter by machine (machine_code)
# @ref baseline
GET {{baseUrl}}/production-orders
    ?machine={{sampleMachineCode}}
    &per_page=100

### Filter by status = RUNNING
GET {{baseUrl}}/production-orders
    ?status=RUNNING
    &per_page=100

### Filter by status = CANCELLED (lowercase input is accepted)
GET {{baseUrl}}/production-orders
    ?status=cancelled
    &per_page=100

### Filter by planned start date
# @ref baseline
GET {{baseUrl}}/production-orders
    ?date={{samplePlanDate}}
    &per_page=100

### All filters combined
# @ref baseline
GET {{baseUrl}}/production-orders
    ?search={{sampleWo}}
    &product={{sampleProductCode}}
    &machine={{sampleMachineCode}}
    &status={{sampleStatus}}
    &date={{samplePlanDate}}

### Page 1 with per_page=5
# @name page1
GET {{baseUrl}}/production-orders
    ?per_page=5
    &page=1

### Page 2 with per_page=5
# @ref page1
GET {{baseUrl}}/production-orders
    ?per_page=5
    &page=2

### Last page with per_page=5
# @ref page1
GET {{baseUrl}}/production-orders
    ?per_page=5
    &page={{lastPage}}

### Page beyond the last
GET {{baseUrl}}/production-orders
    ?per_page=5
    &page=999999

### Pagination keeps the filters
GET {{baseUrl}}/production-orders
    ?status=FINISHED
    &per_page=5

### Sort by target_qty ASC
GET {{baseUrl}}/production-orders
    ?sort_by=target_qty
    &sort_dir=asc
    &per_page=50

### Sort by target_qty DESC
GET {{baseUrl}}/production-orders
    ?sort_by=target_qty
    &sort_dir=desc
    &per_page=50

### Sort by plan_start ASC
GET {{baseUrl}}/production-orders
    ?sort_by=plan_start
    &sort_dir=asc
    &per_page=50

### Default sort = plan_start DESC (no sort params)
GET {{baseUrl}}/production-orders
    ?per_page=50

### Sort by wo_number ASC
GET {{baseUrl}}/production-orders
    ?sort_by=wo_number
    &sort_dir=asc
    &per_page=50

### Sort by product name / machine name
GET {{baseUrl}}/production-orders
    ?sort_by=product
    &sort_dir=asc
    &per_page=10

###
GET {{baseUrl}}/production-orders
    ?sort_by=machine
    &sort_dir=desc
    &per_page=10

### Sort + filter + page together
# @ref baseline
GET {{baseUrl}}/production-orders
    ?machine={{sampleMachineCode}}
    &sort_by=target_qty
    &sort_dir=desc
    &per_page=5
    &page=1

### Invalid status
GET {{baseUrl}}/production-orders?status=DONE

### Invalid sort column
GET {{baseUrl}}/production-orders?sort_by=password

### Invalid sort direction
GET {{baseUrl}}/production-orders?sort_dir=ascdesc

### per_page out of range (0 and 500)
GET {{baseUrl}}/production-orders?per_page=0

###
GET {{baseUrl}}/production-orders?per_page=500

### Invalid date format
GET {{baseUrl}}/production-orders?date=31-12-2026
